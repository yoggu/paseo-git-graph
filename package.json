{
  "name": "paseo-git-graph",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "license": "(MIT AND Apache-2.0)",
  "description": "Paseo port of yoggu/dsh-git-graph: compact Git history, working-tree diffs and confirmed Git actions.",
  "files": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "README.md",
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:syntax": "esbuild server/syntax.js --bundle --platform=node --format=esm --minify --legal-comments=inline --outfile=server/syntax-runtime.js --banner:js=\"/*! Generated from the Paseo diff highlighter and @getpaseo/highlight 0.11.0-beta.5 (Lezer/CodeMirror). See THIRD_PARTY_NOTICES.md and licenses/. */\"",
    "test": "node --experimental-strip-types --test --test-concurrency=2 tests/*.test.js",
    "test:browser": "node --experimental-strip-types tests/browser/run.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.0-beta.5",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.58.2",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@getpaseo/highlight": "0.11.0-beta.5"
  }
}
